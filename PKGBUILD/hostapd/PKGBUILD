validpgpkeys=(EC4AA0A991A5F2464582D52D2B6EF432EFC895FA)

prepare() {
  # make include locations in main configuration file filesystem compliant
  patch -Np1 -d "$_name" -i ../$pkgname-2.11-fhs-config.patch

  # link build configuration into place
  ln -sv ../../config "$_name/$pkgname/.config"
}

build() {
  make -C "$_name/$pkgname"
}

package() {
  cd "$_name"

  make -C "$pkgname" install DESTDIR="$pkgdir" BINDIR=/usr/bin

  # systemd service units
  install -vDm 644 ../hostapd.service "$pkgdir/usr/lib/systemd/system/hostapd.service"
  install -vDm 644 ../hostapd@.service "$pkgdir/usr/lib/systemd/system/hostapd@.service"

  # license
  install -vDm 644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"

  # configuration files (etc and factory copy)
  install -vDm 640 "$pkgname/$pkgname.accept" "$pkgdir/etc/$pkgname/$pkgname.accept"
  install -vDm 640 "$pkgname/$pkgname.conf" "$pkgdir/etc/$pkgname/$pkgname.conf"
  install -vDm 640 "$pkgname/$pkgname.deny" "$pkgdir/etc/$pkgname/$pkgname.deny"
  install -vDm 640 "$pkgname/$pkgname.eap_user" "$pkgdir/etc/$pkgname/$pkgname.eap_user"
  install -vDm 640 "$pkgname/$pkgname.radius_clients" "$pkgdir/etc/$pkgname/$pkgname.radius_clients"
  install -vDm 640 "$pkgname/$pkgname.vlan" "$pkgdir/etc/$pkgname/$pkgname.vlan"
  install -vDm 640 "$pkgname/$pkgname.wpa_psk" "$pkgdir/etc/$pkgname/$pkgname.wpa_psk"

  install -vDm 640 "$pkgname/$pkgname.accept" "$pkgdir/usr/share/factory/etc/$pkgname/$pkgname.accept"
  install -vDm 640 "$pkgname/$pkgname.conf" "$pkgdir/usr/share/factory/etc/$pkgname/$pkgname.conf"
  install -vDm 640 "$pkgname/$pkgname.deny" "$pkgdir/usr/share/factory/etc/$pkgname/$pkgname.deny"
  install -vDm 640 "$pkgname/$pkgname.eap_user" "$pkgdir/usr/share/factory/etc/$pkgname/$pkgname.eap_user"
  install -vDm 640 "$pkgname/$pkgname.radius_clients" "$pkgdir/usr/share/factory/etc/$pkgname/$pkgname.radius_clients"
  install -vDm 640 "$pkgname/$pkgname.vlan" "$pkgdir/usr/share/factory/etc/$pkgname/$pkgname.vlan"
  install -vDm 640 "$pkgname/$pkgname.wpa_psk" "$pkgdir/usr/share/factory/etc/$pkgname/$pkgname.wpa_psk"

  # tmpfiles.d
  install -vDm 644 ../$pkgname.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/$pkgname.conf"
}

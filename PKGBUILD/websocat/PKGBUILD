pkgname=websocat
pkgver=1.14.1
pkgrel=1
pkgdesc='Command-line client for web sockets, like netcat/curl/socat for ws://'
url='https://github.com/vi/websocat/'
arch=('armv6h')
license=('MIT')
depends=('glibc' 'openssl' 'libgcc')
makedepends=('cargo')
source=("${url}/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha512sums=('668fc221eac88b2d9cb385cdd7e06f0593b7570d0316aa096f6711d817b6886793c08ff05daeddee6d3845c62432593cb1939196cf182bc58104c5f2ed218d43')

# Define your cross-toolchain variables here
_target="arm-unknown-linux-gnueabihf"
_sysroot="/home/x/x-sysroot"

build() {
  cd "${pkgname}-${pkgver}"

  _toolchain_dir="/home/x/x-tools/armv6-rpi-linux-gnueabihf/bin"
  export PATH="$_toolchain_dir:$PATH"

  _gcc_path=$(ls $_toolchain_dir/*-gcc | head -n 1)
  _prefix_full=$(basename "$_gcc_path")
  _triple_prefix="${_prefix_full%-gcc}"

  # Also pass sysroot to standard C flags just to be safe
  export CFLAGS="--sysroot=$_sysroot"
  export CXXFLAGS="--sysroot=$_sysroot"
  export LDFLAGS="--sysroot=$_sysroot"

  export CC="$_gcc_path"
  export CXX="$_toolchain_dir/$_triple_prefix-g++"
  export AR="$_toolchain_dir/$_triple_prefix-ar"
  export RANLIB="$_toolchain_dir/$_triple_prefix-ranlib"
  
  export CC_arm_unknown_linux_gnueabihf="$CC"
  export CXX_arm_unknown_linux_gnueabihf="$CXX"
  export AR_arm_unknown_linux_gnueabihf="$AR"
  export CARGO_TARGET_ARM_UNKNOWN_LINUX_GNUEABIHF_LINKER="$CC"
  
  export PKG_CONFIG_ALLOW_CROSS=1
  export PKG_CONFIG_PATH=""
  export PKG_CONFIG_LIBDIR="$_sysroot/usr/lib/pkgconfig:$_sysroot/usr/share/pkgconfig"
  export PKG_CONFIG_SYSROOT_DIR="$_sysroot"

  export OPENSSL_DIR="$_sysroot/usr"
  export OPENSSL_LIB_DIR="$_sysroot/usr/lib"
  export OPENSSL_INCLUDE_DIR="$_sysroot/usr/include"
  export OPENSSL_NO_VENDOR=1

  # NEW: Force the linker to remap '/' to your sysroot directory
  export RUSTFLAGS="-C link-arg=--sysroot=$_sysroot -L native=$_sysroot/usr/lib -L native=$_sysroot/lib"

  cargo build --target "$_target" --release --features=ssl
}

package() {
  cd "${pkgname}-${pkgver}"
  # Target binary is located in the folder named after the target triplet
  install -Dm 755 "target/$_target/release/websocat" -t "${pkgdir}/usr/bin"
  install -Dm 644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
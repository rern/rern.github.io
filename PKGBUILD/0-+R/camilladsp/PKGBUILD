# curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh
# re-login

pkgname=camilladsp
pkgver=4.1.3
pkgrel=2
pkgdesc='IIR and FIR engine for crossovers, room correction etc.'
url=https://github.com/HEnquist/camilladsp
arch=(x86_64 aarch64 armv7h)
license=(GPL-3.0-only)
depends=(alsa-lib gcc-libs glibc openssl)
install=camilladsp.install
source=(https://github.com/HEnquist/camilladsp/archive/refs/tags/v$pkgver.tar.gz
        camilladsp.default
        camilladsp.install
        camilladsp.service
        camilladsp.yml
        state.yml)
sha256sums=('7e2fdca1e9c73885426ac889d27682c76d49ea1ea52c5f5bfe5356d7fdfa52df'
            '3b89ce3546e58782a25ccc480915315422edb3915481cedd578fb52232c3dfb8'
            '4ba985ecc5afd9a8f17b589b810ea323d0dc9abd0fb6d0f2d7b6b9d25ed8b4ba'
            'd5df5dfb0dac64a1e0be3f8802d18aa406f22a1bb8992c5ee02d6d0c2ce1f631'
            '92a587bccbae1c4d014cf7ebc4629624954dd621c175f0d342dbcb9260b61df6'
            'b1cf5192986ee4497546bf9d58c64b28f9c7d2d1e3efb4ef7b69fedd4a7904d1')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --target "$(rustc -vV | sed -n 's/host: //p')"
}
build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --features bluez-backend
}
check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release --features bluez-backend
}
package() {
    cd $srcdir
    install -Dm 755 $pkgname $pkgdir/usr/bin/$pkgname
    install -d $pkgdir/etc/camilladsp/coeffs
    install -Dm 644 camilladsp.default $pkgdir/etc/default/camilladsp
    install -Dm 644 camilladsp.service -t $pkgdir/usr/lib/systemd/system
    install -Dm 755 camilladsp.yml -t $pkgdir/etc/camilladsp/configs
    install -Dm 755 state.yml -t $pkgdir/etc/camilladsp
}

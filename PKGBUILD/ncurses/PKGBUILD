pkgname=ncurses
pkgver=6.6
pkgrel=2
pkgdesc='System V Release 4.0 curses emulation library'
arch=(armv6h)
url='https://invisible-island.net/ncurses/ncurses.html'
license=(MIT-open-group)
options=(!strip)
depends=(
glibc
libgcc
libstdc++
)
makedepends=(
autoconf-archive
git
)
optdepends=('bash: for ncursesw6-config')
provides=(
libncurses++w.so
libformw.so
libmenuw.so
libpanelw.so
libncursesw.so
)
replaces=(
alacritty-terminfo
rio-terminfo
wezterm-terminfo
)
source=(
$pkgname::git+https://github.com/ThomasDickey/ncurses-snapshots.git?signed#tag=v${pkgver/./_}
$pkgname-6.6-libs.patch
$pkgname-6.6-pkgconfig.patch
)
sha512sums=('cad17bf83ef3ccd71fb7c33933ddbbbef2e8bd050d5e4e4ebb344b5df8292b1cd3c9e1787e88087d73cc96f625ba0c7cd6714d7720af7f8bd50b314e9838d2a7'
'aa1d2cdc5bce7a99b277f2ecd4a109a337ba39f3ec522c3daf52dba0c1be05c9f0bf695d8bdfdbda1c1f6f3f7214ef0eb4b5b9e1b7e9f05db14419b3bc6ab271'
'c74c9393659e1d744995285f270531108320975da8ca39b0e4cdcaa07a51cdd977bcfbf8eb131c6a81ba2e63e92bb185947ce6a1231c8bb8a2e5e6035c385cfa')
b2sums=('af7f3dd1fd2d471d6b1b144acfbf4f44bdbf040ff8746a48aa9fdcc86f74a004939a31204d22966ef857096ccd7da6ee74769996e082a5a2735b1e6e934319a3'
'29f2c29e229687b8539be5147ce35f08b8a8eeead880a8a34189b3a02400fd752ee96314eed3e175503281dc05bf3668f26edeca4540668592d46d4cddc9aef4'
'd8c079262332253c758f1c42ff642db0b14a86695dcaa735a73615ab594f65e0d1de3e31732ff7c413078b43f8e71e86b6ce41236e54e049ecf65d8cf7587e0a')

_cross_triple=armv6-rpi-linux-gnueabihf
_cross_toolchain=/home/x/x-tools/${_cross_triple}/bin
_cross_sysroot=/home/x/x-sysroot

prepare() {
export PATH="$_cross_toolchain:$PATH"

patch -Np1 -d $pkgname -i ../$pkgname-6.6-libs.patch
patch -Np1 -d $pkgname -i ../$pkgname-6.6-pkgconfig.patch

# ncurses' configure has a known-broken "checking if $CXX works" test
# (upstream comment: "particularly when cross-compiling") that injects
# -I${includedir}, which resolves to /usr/include and pulls in the BUILD
# host's glibc headers instead of the target sysroot's. Neutralize it.
sed -i 's|CPPFLAGS="\$CPPFLAGS -I\${cf_includedir}"|CPPFLAGS="$CPPFLAGS"|' $pkgname/configure
}

build() {
export PATH="$_cross_toolchain:$PATH"
export CC="${_cross_triple}-gcc"
export CXX="${_cross_triple}-g++"
export AR="${_cross_triple}-ar"
export RANLIB="${_cross_triple}-ranlib"
export STRIP="${_cross_triple}-strip"
export PKG_CONFIG_PATH="$_cross_sysroot/usr/lib/pkgconfig"
export PKG_CONFIG_SYSROOT_DIR="$_cross_sysroot"
export PKG_CONFIG_LIBDIR="$_cross_sysroot/usr/lib/pkgconfig"

unset CFLAGS CXXFLAGS LDFLAGS CPPFLAGS
unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH LIBRARY_PATH

local configure_options=(
--prefix=/usr
--host=$_cross_triple
--build=x86_64-pc-linux-gnu
--disable-root-access
--disable-root-environ
--disable-setuid-environ
--disable-stripping
--enable-widec
--enable-pc-files
--without-manpages
--with-cxx-binding
--with-cxx-shared
--with-pkg-config-libdir=/usr/lib/pkgconfig
--with-shared
--with-versioned-syms
--with-xterm-kbs=del
--without-ada
CC="$CC"
CXX="$CXX"
CXXCPP="$CXX -E"
  )

cd $pkgname
./configure "${configure_options[@]}"
make
}

package() {
export PATH="$_cross_toolchain:$PATH"
export CC="${_cross_triple}-gcc"
export CXX="${_cross_triple}-g++"
export AR="${_cross_triple}-ar"
export RANLIB="${_cross_triple}-ranlib"
export STRIP="${_cross_triple}-strip"

unset CFLAGS CXXFLAGS LDFLAGS CPPFLAGS
unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH LIBRARY_PATH

local _pkgver=${pkgver/_*/}

make DESTDIR="$pkgdir" install -C $pkgname
install -vDm 644 $pkgname/COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"

for lib in ncurses ncurses++ form panel menu; do
printf "INPUT(-l%sw)\n" "${lib}" > "$pkgdir/usr/lib/lib${lib}.so"
ln -sv ${lib}w.pc "$pkgdir/usr/lib/pkgconfig/${lib}.pc"
done

printf 'INPUT(-lncursesw)\n' > "$pkgdir/usr/lib/libcursesw.so"
ln -sv libncurses.so "$pkgdir/usr/lib/libcurses.so"

for lib in tic tinfo; do
printf "INPUT(libncursesw.so.%s)\n" "${_pkgver:0:1}" > "$pkgdir/usr/lib/lib${lib}.so"
ln -sv libncursesw.so.${pkgver:0:1} "$pkgdir/usr/lib/lib${lib}.so.${_pkgver:0:1}"
ln -sv ncursesw.pc "$pkgdir/usr/lib/pkgconfig/${lib}.pc"
done

rm -rf "$pkgdir"/usr/share/man
}
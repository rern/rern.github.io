noautobuild=1

pkgname=(
  gcc
  gcc-libs
  libatomic
  libgcc
  libgomp
  libitm
  libstdc++
)
pkgver=16.1.1+r12+g301eb08fa2c5
_commit=301eb08fa2c5b6f3045260bf1294c2e2bacbcd90
pkgrel=1
pkgdesc='The GNU Compiler Collection (Cross-compiled native for ARMv6h Pi Zero)'
arch=(armv6h)
CARCH="armv6h"
CHOST="armv6-rpi-linux-gnueabihf"
license=(
  'GPL-3.0-or-later WITH GCC-exception-3.1'
  GFDL-1.3-or-later
)
url='https://gcc.gnu.org'
makedepends=(
  binutils
  crosstool-ng
  git
  python
  zstd
)
options=(
  !emptydirs
  !lto
  !distcc
  !strip
  !zipman
  !buildflags
)
_libdir=usr/lib/gcc/$CHOST/${pkgver%%+*}
_sysroot="$HOME/x-tools/armv6-rpi-linux-gnueabihf/armv6-rpi-linux-gnueabihf/sysroot"
source=(git+https://sourceware.org/git/gcc.git#commit=$_commit)
sha256sums=('SKIP')

pkgver() {
  cd gcc
  echo "$(cat gcc/BASE-VER)+$(git describe --abbrev=12 --tags | sed 's/[^-]*-[^-]*-//;s/[^-]*-/r&/;s/-/+/g;s/_/./')"
}

prepare() {
  [[ ! -d gcc ]] && ln -s gcc-${pkgver/+/-} gcc
  cd gcc
  ./contrib/download_prerequisites --no-verify
  cd ..
  mkdir -p "$srcdir/gcc-build"
}

build() {
  export PATH="$HOME/x-tools/armv6-rpi-linux-gnueabihf/bin:$PATH"

  local _confflags=(
      --build=x86_64-pc-linux-gnu
      --host=armv6-rpi-linux-gnueabihf
      --target=armv6-rpi-linux-gnueabihf
      --with-sysroot=$_sysroot
      --prefix=/usr
      --libdir=/usr/lib
      --libexecdir=/usr/lib
      --without-system-zlib
      --disable-bootstrap
      --disable-multilib
      --disable-werror
      --disable-libsanitizer
      --enable-languages=c,c++
  )

  cd gcc-build
  "$srcdir/gcc/configure" "${_confflags[@]}"
  make
}

check() {
  echo 'Skip check()'
}

_install_runtime_library_exception() {
  install -Dm644 "$srcdir/gcc/COPYING.RUNTIME" \
    "$pkgdir/usr/share/licenses/$pkgname/RUNTIME.LIBRARY.EXCEPTION"
}

_strip_arm() {
  local _strip="$HOME/x-tools/armv6-rpi-linux-gnueabihf/bin/armv6-rpi-linux-gnueabihf-strip"
  find "$pkgdir" -type f \( -perm -u+x -o -name '*.so*' \) ! -name '*.a' ! -name '*.o' -print0 \
    | xargs -0 -r "$_strip" --strip-unneeded 2>/dev/null || true
}

package_gcc() {
  pkgdesc="The GNU Compiler Collection - C and C++ frontends"
  depends=(
    "gcc-libs=$pkgver-$pkgrel"
    "libgcc=$pkgver-$pkgrel"
    "libstdc++=$pkgver-$pkgrel"
    'binutils>=2.28'
    'glibc>=2.27'
    gmp
    libmpc
    mpfr
  )
  options=(!emptydirs staticlibs !strip)

  cd gcc-build

  make -C gcc DESTDIR="$pkgdir" install-driver install-cpp install-gcc-ar \
    c++.install-common install-headers install-plugin install-lto-wrapper

  # liblto_plugin.so is needed at link time because g++ defaults to
  # -fuse-linker-plugin even for non-LTO builds; built under the separate
  # top-level lto-plugin/ directory, not part of gcc/'s own install targets
  make -C lto-plugin DESTDIR="$pkgdir" install

  # C++ standard library headers (<algorithm>, <vector>, ...) ship with gcc,
  # matching stock Arch layout -- libstdc++ package carries only the .so
  make -C $CHOST/libstdc++-v3/include DESTDIR="$pkgdir" install

  # libsupc++ ships compiler-support headers (<compare>, bits/exception.h,
  # etc.) that aren't part of include/std -- install-data-am pulls in both
  # its bitsHEADERS and stdHEADERS lists without touching its libraries
  make -C $CHOST/libstdc++-v3/libsupc++ DESTDIR="$pkgdir" install-data-am

  install -m755 -t "$pkgdir/usr/bin/" gcc/gcov{,-tool,-dump}
  install -m755 -t "$pkgdir/$_libdir/" gcc/{cc1,cc1plus,collect2,lto1}

  ln -sf gcc "$pkgdir/usr/bin/cc"

  for binary in gcc g++; do
    ln -sf $binary "$pkgdir/usr/bin/$CHOST-$binary"
  done

  _strip_arm
  _install_runtime_library_exception
}

package_gcc-libs() {
  pkgdesc='Runtime libraries shipped by GCC'
  depends=('glibc>=2.27' libatomic libgcc libgomp libitm libstdc++)
}

package_libatomic() {
  pkgdesc='GNU Atomic library shipped by GCC'
  depends=('glibc>=2.27')
  provides=(libatomic.so)

  cd gcc-build
  make -C $CHOST/libatomic DESTDIR="$pkgdir" install-toolexeclibLTLIBRARIES

  _strip_arm
  _install_runtime_library_exception
}

package_libgcc() {
  pkgdesc='Low-level runtime library shipped by GCC'
  depends=('glibc>=2.27')
  provides=(libgcc_s.so)

  cd gcc-build
  make -C $CHOST/libgcc DESTDIR="$pkgdir" install-shared
  # crtbegin.o/crtend.o (link-time startup objects) and the static libgcc.a
  # archive are needed by every link step (-lgcc, crt*.o) but aren't part
  # of install-shared, which only covers libgcc_s.so
  make -C $CHOST/libgcc DESTDIR="$pkgdir" install
  rm -f "$pkgdir/$_libdir/libgcc_eh.a"

  _strip_arm
  _install_runtime_library_exception
}

package_libgomp() {
  pkgdesc='OpenMP library shipped by GCC'
  depends=('glibc>=2.27')
  provides=(libgomp.so)

  cd gcc-build
  make -C $CHOST/libgomp DESTDIR="$pkgdir" install-toolexeclibLTLIBRARIES

  _strip_arm
  _install_runtime_library_exception
}

package_libitm() {
  pkgdesc='GNU Transactional Memory library shipped by GCC'
  depends=('glibc>=2.27' libgcc)
  provides=(libitm.so)

  cd gcc-build
  make -C $CHOST/libitm DESTDIR="$pkgdir" install-toolexeclibLTLIBRARIES

  _strip_arm
  _install_runtime_library_exception
}

package_libstdc++() {
  pkgdesc='C++ runtime libraries shipped by GCC'
  depends=('glibc>=2.27' libgcc)
  provides=(libstdc++.so)

  cd gcc-build
  make -C $CHOST/libstdc++-v3/src DESTDIR="$pkgdir" install-toolexeclibLTLIBRARIES
  make -C $CHOST/libstdc++-v3/po DESTDIR="$pkgdir" install

  _strip_arm
  _install_runtime_library_exception
}

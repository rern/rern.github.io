pkgname=maturin
pkgver=1.14.1
pkgrel=1
pkgdesc="Build and publish crates (armv6h cross-compiled)"
arch=('armv6h')
source=("maturin::git+https://github.com/PyO3/maturin.git#tag=v$pkgver")
sha512sums=('SKIP')

build() {
  cd maturin

  # 1. Define the target
  export TARGET="arm-unknown-linux-gnueabihf"
  export SYSROOT="/home/x/x-sysroot"
  
  # 2. Setup the Cargo config file to force the correct linker
  # This prevents Cargo from defaulting to the host's x86_64 linker/lld
  mkdir -p .cargo
  cat <<EOF > .cargo/config.toml
[target.$TARGET]
linker = "armv6-rpi-linux-gnueabihf-gcc"
rustflags = ["-C", "link-arg=--sysroot=$SYSROOT"]
EOF

  # 3. Map compiler variables (needed by crates like 'ring')
  export CC_${TARGET//-/_}="armv6-rpi-linux-gnueabihf-gcc"
  export CXX_${TARGET//-/_}="armv6-rpi-linux-gnueabihf-g++"
  export AR_${TARGET//-/_}="armv6-rpi-linux-gnueabihf-ar"

  # 4. Clean environment flags (prevents host pollution)
  unset CFLAGS CXXFLAGS LDFLAGS

  # 5. Build
  # We include the path to your tools just in case
  export PATH="/home/x/x-tools/armv6-rpi-linux-gnueabihf/bin:$PATH"
  cargo build --release --target $TARGET
}

package() {
  cd maturin
  
  # The binary is now in the target triplet directory
  install -vDm755 target/arm-unknown-linux-gnueabihf/release/maturin "$pkgdir/usr/bin/maturin"
  
  # If you have license files, include them here as well
  install -vDm644 license-mit "$pkgdir/usr/share/licenses/$pkgname/license-mit"
}